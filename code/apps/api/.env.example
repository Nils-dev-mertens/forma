# Forma API environment variables
# Copy to `.env` and fill in values. Loaded via dotenv from the API working
# directory (`code/apps/api/.env` when running through turbo).

# Port the API listens on (default 3001).
# PORT=3001

# Allowed CORS origin (defaults to http://localhost:3001).
# ORIGIN=http://localhost:3001

# Secret used to sign session cookies. Dev falls back to an insecure default;
# set a long random value in any non-development environment.
# Generate one with: openssl rand -hex 32
# SESSION_SECRET=

# REQUIRED to store/decrypt AI provider keys (AES-256-GCM). The API throws if
# this is unset when an AI key is saved or used.
# Generate one with: openssl rand -hex 32
# AI_ENCRYPTION_KEY=

# Default model used for AI generations (default gpt-4o-mini).
# AI_DEFAULT_MODEL=gpt-4o-mini

# Per-user rolling 24h token budget for AI usage (default 200000). Set 0 to disable.
# AI_DAILY_TOKEN_LIMIT=200000

# Runtime environment: development | test | production (defaults to
# development; see AuthHandler for the auto-auth behavior).
# NODE_ENV=development

# SQLite database path used by @repo/db (defaults to code/db.sqlite).
# Use `:memory:` for tests.
# FORMA_DB_PATH=code/db.sqlite

# Upload limits for image fields (per file / per side / files per request).
# MAX_IMAGE_BYTES=10485760        # 10 MB per file
# MAX_IMAGE_DIMENSION=8192        # max width/height in pixels
# MAX_UPLOAD_FILES=10             # max files per request

# --- Optional auth tunables (packages/auth) ---
# PASSWORD_ALGORITHM=scrypt          # 'bcrypt' or 'scrypt'
# BCRYPT_SALT_ROUNDS=12
# SCRYPT_SALT_LENGTH=16
# SCRYPT_KEY_LENGTH=64
# SCRYPT_COST_PARAMETER=16384
# SCRYPT_BLOCK_SIZE=8
# SCRYPT_PARALLELIZATION=1